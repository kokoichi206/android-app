<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- インストール済みアプリを列挙するため (Android 11+ の package visibility) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <!-- 既定ホーム時に付与される権限。未宣言だと「デフォルトのホームアプリ」ダイアログで
         「必要な権限がありません」と注記される（Launcher3 も宣言している）。
         API 35+ では RECEIVE_SENSITIVE_NOTIFICATIONS も HOME ロールの付与対象
         （prot=...|role なので役割保持者には付与可能）。両方宣言して注記を解消する。 -->
    <uses-permission android:name="android.permission.READ_HOME_APP_SEARCH_DATA" />
    <uses-permission android:name="android.permission.RECEIVE_SENSITIVE_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.Oshi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 推し画像のスライドショー・ライブ壁紙（ロック画面でも描画される正規ルート） -->
        <service
            android:name=".wallpaper.SlideshowWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/oshi_wallpaper" />
        </service>
    </application>

</manifest>
